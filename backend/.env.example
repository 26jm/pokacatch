SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
UPSTAGE_API_KEY=your-upstage-api-key
UPSTAGE_MODEL=solar-pro2
PORT=3000

# 앱 로그인 JWT 서명키. 운영 환경에서 32자 이상의 무작위 값으로 설정하고 외부에 공개하지 마세요.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENT_WEBHOOK_SECRET=replace-with-a-different-32-character-secret
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`로 생성
ACCOUNT_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
RESEND_API_KEY=
EMAIL_FROM=Poka-Catch <no-reply@your-verified-domain.example>

# 소셜 로그인(OAuth).
# 구글/카카오는 Supabase Auth Dashboard(Authentication > Providers)에 Client ID/Secret을 등록해서 사용합니다 (백엔드에는 불필요).
# 네이버는 Supabase 미지원 제공자라 아래 값으로 백엔드가 직접 OAuth를 처리합니다.
# 트위터는 연동 보류 (계정 인증 신뢰도 기능 도입 시 추가 예정).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 OAuth 콜백에 사용되는 서버/프런트 기본 주소 (네이버 개발자센터의 Redirect URI 설정과 일치해야 함)
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# 네이버 OAuth state 서명용 비밀키 (선택). 비워두면 NAVER_CLIENT_SECRET 또는 SUPABASE_SERVICE_ROLE_KEY로 대체됩니다.
OAUTH_STATE_SECRET=
